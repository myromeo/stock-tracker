# Copy this file to .env and fill in your values. Never commit the real .env.

# Get a free key at https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=your_key_here

# Comma-separated list of ticker symbols to track
SYMBOLS=AAPL,MSFT,GOOGL

# Postgres / TimescaleDB
POSTGRES_USER=stockuser
POSTGRES_PASSWORD=change_this_password
POSTGRES_DB=stocks

# How often (minutes) the ingestion service polls Alpha Vantage.
# Free tier = 5 calls/min, 500 calls/day. With N symbols, one poll cycle
# uses N calls, so POLL_INTERVAL_MINUTES * (1440 / POLL_INTERVAL_MINUTES) * N
# must stay under 500/day. Defaults are safe for up to ~5 symbols at 15 min.
POLL_INTERVAL_MINUTES=15

# Forecast horizon in days, and how often the model retrains
FORECAST_DAYS=14
RETRAIN_INTERVAL_HOURS=6

# --- Only needed if running docker-compose.prod.yml (pre-built GHCR images) ---
# GitHub username/org that owns the images, e.g. myromeo
GITHUB_OWNER=myromeo
# Image tag to pull: "latest" (main branch), a version like "v1.0.0", or a
# short commit sha like "sha-abc1234"
IMAGE_TAG=latest
